{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dominion-randomizer",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "dominion.adambyle.net", "custom_domain": true }],
  "observability": { "enabled": true }
  // D1 (accounts, history) and a Durable Object (multiplayer rooms) get added back here when those
  // features are built — see docs/ROADMAP.md.
}
