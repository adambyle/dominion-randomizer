{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dominion-randomizer",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "dominion.adambyle.net", "custom_domain": true }],
  "observability": { "enabled": true },
  // Accounts, history and synced settings. No database_id: `wrangler deploy` creates the database
  // on first deploy (automatic provisioning) and the Worker creates its tables on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "dominion-randomizer" }],
  // Multiplayer rooms: one Durable Object per room code (SQLite-backed storage).
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
